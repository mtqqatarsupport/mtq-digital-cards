# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ── Firebase service account (server only) ──
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Paste the whole key including the BEGIN/END lines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase web app (used by the "Continue with Google" button; these are public) ──
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
FIREBASE_WEB_API_KEY="AIza..."
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_WEB_APP_ID="1:123456789:web:abc123"

# ── Public address of the site, no trailing slash (used for card links, QR codes, vCards) ──
APP_URL="https://mtq-cards.vercel.app"
